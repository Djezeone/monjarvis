# =============================================================================
# JARVIS X2 — Core. Copiez ce fichier en apps/web/.env.local et remplissez.
#
# Règle de lecture : chaque variable absente a une CONSÉQUENCE écrite. JARVIS
# ne fait jamais semblant — un organe non configuré se déclare non configuré.
# Vérifiez votre configuration avant de démarrer : npm run preflight
# =============================================================================

# --- Rôle et données --------------------------------------------------------

# Le Core est le cerveau : registres, ticker 60 s, secrets. Sur Vercel le rôle
# bascule automatiquement en « facade » ; ici on l'affirme explicitement.
JARVIS_ROLE=core

# Où vivent TOUS les registres (appareils, sessions, préférences, routines,
# suggestions, apprentissages, skills, abonnements push, n8n, maison,
# navigateur). C'est aussi ce que l'Identity Pack exporte.
# Absente → ./data à côté de l'app. Choisissez un chemin sauvegardé.
JARVIS_DATA_DIR=/var/lib/jarvis/data

# --- Intelligence (P3) ------------------------------------------------------

# Hermes tourne en natif (`hermes gateway`), jamais dans une Function.
# Absentes → le cockpit affiche « intelligence core non configuré » et tout
# run répond 503. N'exposez JAMAIS 8642 publiquement.
HERMES_API_URL=http://127.0.0.1:8642
HERMES_API_KEY=

# Mémoire Graphiti (service uvicorn local, voir deploy/core/README.md).
# Absente → l'organe mémoire se déclare non configuré, le reste fonctionne.
GRAPHITI_MEMORY_URL=http://127.0.0.1:8771

# --- Façade et sécurité (P6, P9) --------------------------------------------

# Le MÊME secret que la façade Vercel = session unique (SSO).
# 24 caractères minimum : en dessous, la façade refuse TOUT LE MONDE, y
# compris avec le bon secret. Absent → mode local ouvert (à réserver à une
# machine dont vous contrôlez le réseau).
#   openssl rand -base64 32
JARVIS_AUTH_SECRET=

# Origines autorisées à piloter ce Core en écriture, en plus de la sienne.
# Sans cette ligne, votre façade Vercel reçoit 403 sur chaque écriture.
# Les agents satellites et curl n'envoient pas d'Origin : ils ne sont pas
# concernés.
JARVIS_TRUSTED_ORIGINS=https://votre-app.vercel.app

# --- Notifications push (P6-5) ----------------------------------------------

# Générez la paire une fois :  cd apps/web && npm run vapid
# Absentes → le panneau push dit « clés VAPID absentes » et rien n'est poussé.
JARVIS_VAPID_PUBLIC_KEY=
JARVIS_VAPID_PRIVATE_KEY=
JARVIS_VAPID_SUBJECT=mailto:vous@example.com

# --- Connecteur n8n (P8-1) --------------------------------------------------

# Absentes → l'organe n8n se déclare non configuré et aucun workflow n'est
# déclenchable. Le webhook DOIT vérifier l'en-tête X-Jarvis-Secret.
N8N_BASE_URL=http://127.0.0.1:5678
N8N_WEBHOOK_BASE_URL=http://127.0.0.1:5678/webhook
N8N_JARVIS_SECRET=

# --- Connecteur Home Assistant (P8-2) ---------------------------------------

# Jeton d'accès longue durée (profil HA → Jetons). Absentes → organe non
# configuré. JARVIS ne touchera que les entités déclarées dans le cockpit,
# et les domaines gardés (serrures, alarmes, volets, chauffage) demanderont
# votre accord à chaque action, même déclarés.
HASS_URL=http://127.0.0.1:8123
HASS_TOKEN=

# --- Navigateur agentique (P8-3) — ÉTEINT PAR DÉFAUT ------------------------

# Un navigateur porte vos sessions connectées. Avoir l'URL et le jeton ne
# suffit pas : sans JARVIS_BROWSER_ENABLED=1 le connecteur reste muet.
# Chaque tâche exige une approbation explicite ; il n'existe volontairement
# aucun niveau « lecture seule ».
JARVIS_BROWSER_ENABLED=
JARVIS_BROWSER_WORKER_URL=http://127.0.0.1:8772
JARVIS_BROWSER_WORKER_TOKEN=
# Plafond de pas par tâche (défaut 12) — une demande à 99 part à ce plafond.
JARVIS_BROWSER_MAX_STEPS=12

# --- Réglages fins (tous optionnels, valeurs par défaut indiquées) ----------

# Suggestions proactives (P5-3)
JARVIS_SUGGEST_OFFLINE_MIN=10
JARVIS_SUGGEST_FAILED_WINDOW_MIN=60

# Préférences apprises (P5-4) — l'inférence propose, l'humain dispose
JARVIS_LEARN_WINDOW_DAYS=7
JARVIS_LEARN_MIN_RUNS=5
JARVIS_LEARN_MIN_SHARE=0.6
JARVIS_LEARN_QUIET_MIN_DAYS=5
JARVIS_LEARN_QUIET_MIN_GAP_H=6

# Skill learning (P5-5) — derrière approbation (FR-009)
JARVIS_SKILL_MIN_REPEATS=3
JARVIS_SKILL_WINDOW_DAYS=14
