# JARVIS X2 — server-only environment (never expose these to the client bundle)
# Copy to .env.local and fill in. Every organ is optional: the app loads and
# reports "not configured" for anything left empty (NFR-004).

# Hermes Core (required for /api/jarvis/* run routes)
HERMES_API_URL=http://127.0.0.1:8642
HERMES_API_KEY=

# Graphiti memory service
GRAPHITI_MEMORY_URL=http://127.0.0.1:8771

# Home Assistant (read-only usage first; controls are CRITICAL)
HASS_URL=http://127.0.0.1:8123
HASS_TOKEN=

# n8n allowlisted webhooks
N8N_WEBHOOK_BASE_URL=http://127.0.0.1:5678/webhook
N8N_JARVIS_SECRET=

# Browser worker (stays disabled until sandbox/policy tests pass)
JARVIS_BROWSER_WORKER_URL=http://127.0.0.1:8772
JARVIS_BROWSER_WORKER_TOKEN=

# P4 Omnipresence Fabric — per-device tokens (ADR-002): no shared secret.
# Enroll each satellite from the cockpit (/app -> Présence -> Enrôler un
# appareil); tokens are stored hashed in the registry below.
# Where the Core persists its device registry (default: <apps/web>/data)
# JARVIS_DATA_DIR=
