# Hermes
HERMES_API_URL=http://127.0.0.1:8642
HERMES_API_KEY=CHANGE_ME_RANDOM_SECRET

# Ollama / Graphiti
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
GRAPHITI_LLM_MODEL=qwen3.5:9b
GRAPHITI_EMBED_MODEL=nomic-embed-text
GRAPHITI_EMBED_DIM=768
GRAPHITI_STRUCTURED_OUTPUT_MODE=json_schema
SEMAPHORE_LIMIT=2

# Neo4j
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=jarvis-local-password

# Memory service
JARVIS_GRAPHITI_URL=http://127.0.0.1:8771
GRAPHITI_MEMORY_URL=http://127.0.0.1:8771

# Browser worker
JARVIS_BROWSER_WORKER_URL=http://127.0.0.1:8772
JARVIS_BROWSER_WORKER_TOKEN=CHANGE_ME_BROWSER_SECRET

# n8n
N8N_WEBHOOK_BASE_URL=http://127.0.0.1:5678/webhook
N8N_JARVIS_SECRET=CHANGE_ME_N8N_SECRET

# Home Assistant
HASS_URL=http://127.0.0.1:8123
HASS_TOKEN=
